<?xml version="1.0"?>
<robot name="robotmp_arm6dof_gripper">
  <material name="arm_blue"><color rgba="0.20 0.34 0.52 1"/></material>
  <material name="arm_light"><color rgba="0.55 0.67 0.79 1"/></material>
  <material name="finger"><color rgba="0.74 0.81 0.89 1"/></material>

  <link name="base">
    <inertial><origin xyz="0 0 0.08"/><mass value="2"/><inertia ixx="0.02" ixy="0" ixz="0" iyy="0.02" iyz="0" izz="0.02"/></inertial>
    <visual><origin xyz="0 0 0.08"/><geometry><cylinder radius="0.12" length="0.16"/></geometry><material name="arm_blue"/></visual>
    <collision><origin xyz="0 0 0.08"/><geometry><cylinder radius="0.12" length="0.16"/></geometry></collision>
  </link>

  <link name="link1">
    <inertial><origin xyz="0 0 0.12"/><mass value="0.7"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/></inertial>
    <visual><origin xyz="0 0 0.12"/><geometry><box size="0.11 0.11 0.24"/></geometry><material name="arm_light"/></visual>
    <collision><origin xyz="0 0 0.12"/><geometry><box size="0.11 0.11 0.24"/></geometry></collision>
  </link>
  <joint name="joint1" type="revolute"><parent link="base"/><child link="link1"/><origin xyz="0 0 0.16"/><axis xyz="0 0 1"/><limit lower="-3.14" upper="3.14" effort="80" velocity="2"/></joint>

  <link name="link2">
    <inertial><origin xyz="0 0 0.16"/><mass value="0.6"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/></inertial>
    <visual><origin xyz="0 0 0.16"/><geometry><box size="0.10 0.10 0.32"/></geometry><material name="arm_blue"/></visual>
    <collision><origin xyz="0 0 0.16"/><geometry><box size="0.10 0.10 0.32"/></geometry></collision>
  </link>
  <joint name="joint2" type="revolute"><parent link="link1"/><child link="link2"/><origin xyz="0 0 0.24"/><axis xyz="0 1 0"/><limit lower="-2.2" upper="2.2" effort="70" velocity="2"/></joint>

  <link name="link3">
    <inertial><origin xyz="0 0 0.14"/><mass value="0.5"/><inertia ixx="0.008" ixy="0" ixz="0" iyy="0.008" iyz="0" izz="0.008"/></inertial>
    <visual><origin xyz="0 0 0.14"/><geometry><box size="0.09 0.09 0.28"/></geometry><material name="arm_light"/></visual>
    <collision><origin xyz="0 0 0.14"/><geometry><box size="0.09 0.09 0.28"/></geometry></collision>
  </link>
  <joint name="joint3" type="revolute"><parent link="link2"/><child link="link3"/><origin xyz="0 0 0.32"/><axis xyz="0 1 0"/><limit lower="-2.5" upper="2.5" effort="60" velocity="2"/></joint>

  <link name="link4">
    <inertial><origin xyz="0 0 0.10"/><mass value="0.35"/><inertia ixx="0.005" ixy="0" ixz="0" iyy="0.005" iyz="0" izz="0.005"/></inertial>
    <visual><origin xyz="0 0 0.10"/><geometry><box size="0.08 0.08 0.20"/></geometry><material name="arm_blue"/></visual>
    <collision><origin xyz="0 0 0.10"/><geometry><box size="0.08 0.08 0.20"/></geometry></collision>
  </link>
  <joint name="joint4" type="revolute"><parent link="link3"/><child link="link4"/><origin xyz="0 0 0.28"/><axis xyz="1 0 0"/><limit lower="-3.14" upper="3.14" effort="40" velocity="2.5"/></joint>

  <link name="link5">
    <inertial><origin xyz="0 0 0.08"/><mass value="0.25"/><inertia ixx="0.003" ixy="0" ixz="0" iyy="0.003" iyz="0" izz="0.003"/></inertial>
    <visual><origin xyz="0 0 0.08"/><geometry><box size="0.07 0.07 0.16"/></geometry><material name="arm_light"/></visual>
    <collision><origin xyz="0 0 0.08"/><geometry><box size="0.07 0.07 0.16"/></geometry></collision>
  </link>
  <joint name="joint5" type="revolute"><parent link="link4"/><child link="link5"/><origin xyz="0 0 0.20"/><axis xyz="0 1 0"/><limit lower="-2.5" upper="2.5" effort="30" velocity="2.5"/></joint>

  <link name="flange">
    <inertial><origin xyz="0 0 0.05"/><mass value="0.15"/><inertia ixx="0.002" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.002"/></inertial>
    <visual><origin xyz="0 0 0.05"/><geometry><cylinder radius="0.055" length="0.10"/></geometry><material name="arm_blue"/></visual>
    <collision><origin xyz="0 0 0.05"/><geometry><cylinder radius="0.055" length="0.10"/></geometry></collision>
  </link>
  <joint name="joint6" type="revolute"><parent link="link5"/><child link="flange"/><origin xyz="0 0 0.16"/><axis xyz="1 0 0"/><limit lower="-3.14" upper="3.14" effort="20" velocity="3"/></joint>

  <link name="left_finger">
    <inertial><origin xyz="0 0 -0.07"/><mass value="0.05"/><inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/></inertial>
    <visual><origin xyz="0 0 -0.07"/><geometry><box size="0.024 0.10 0.14"/></geometry><material name="finger"/></visual>
    <collision><origin xyz="0 0 -0.07"/><geometry><box size="0.024 0.10 0.14"/></geometry></collision>
  </link>
  <joint name="left_finger_joint" type="prismatic"><parent link="flange"/><child link="left_finger"/><origin xyz="-0.08 0 0"/><axis xyz="1 0 0"/><limit lower="0" upper="0.03" effort="5" velocity="1"/><dynamics damping="0.2" friction="0.05"/></joint>

  <link name="right_finger">
    <inertial><origin xyz="0 0 -0.07"/><mass value="0.05"/><inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/></inertial>
    <visual><origin xyz="0 0 -0.07"/><geometry><box size="0.024 0.10 0.14"/></geometry><material name="finger"/></visual>
    <collision><origin xyz="0 0 -0.07"/><geometry><box size="0.024 0.10 0.14"/></geometry></collision>
  </link>
  <joint name="right_finger_joint" type="prismatic"><parent link="flange"/><child link="right_finger"/><origin xyz="0.08 0 0"/><axis xyz="-1 0 0"/><limit lower="0" upper="0.03" effort="5" velocity="1"/><dynamics damping="0.2" friction="0.05"/></joint>
</robot>
