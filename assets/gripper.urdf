<?xml version="1.0"?>
<robot name="robotmp_parallel_gripper">
  <link name="base">
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0"/>
      <geometry><box size="0.13 0.12 0.05"/></geometry>
      <material name="wrist"><color rgba="0.60 0.68 0.77 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0"/>
      <geometry><box size="0.13 0.12 0.05"/></geometry>
    </collision>
  </link>

  <link name="left_finger">
    <inertial>
      <origin xyz="0 0 -0.07"/>
      <mass value="0.05"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.07"/>
      <geometry><box size="0.024 0.10 0.14"/></geometry>
      <material name="finger_left"><color rgba="0.74 0.81 0.89 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 -0.07"/>
      <geometry><box size="0.024 0.10 0.14"/></geometry>
    </collision>
  </link>

  <link name="right_finger">
    <inertial>
      <origin xyz="0 0 -0.07"/>
      <mass value="0.05"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.07"/>
      <geometry><box size="0.024 0.10 0.14"/></geometry>
      <material name="finger_right"><color rgba="0.74 0.81 0.89 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 -0.07"/>
      <geometry><box size="0.024 0.10 0.14"/></geometry>
    </collision>
  </link>

  <joint name="left_finger_joint" type="prismatic">
    <parent link="base"/><child link="left_finger"/>
    <origin xyz="-0.08 0 0"/><axis xyz="1 0 0"/>
    <limit lower="0" upper="0.03" effort="5" velocity="1"/>
    <dynamics damping="0.2" friction="0.05"/>
  </joint>
  <joint name="right_finger_joint" type="prismatic">
    <parent link="base"/><child link="right_finger"/>
    <origin xyz="0.08 0 0"/><axis xyz="-1 0 0"/>
    <limit lower="0" upper="0.03" effort="5" velocity="1"/>
    <dynamics damping="0.2" friction="0.05"/>
  </joint>
</robot>
